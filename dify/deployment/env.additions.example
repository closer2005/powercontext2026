# ============================================================================
# 离谱法庭 · The Absurd Court
# Dify 1.18.0 + seekdb 部署所需的关键 env 片段
#
# 用法：复制下面内容，追加/覆盖到 Dify 源码 docker/.env：
#     cat env.additions.example >> /path/to/dify/docker/.env
# 然后按 deployment/README.md 的顺序启动（先 seekdb → 建库 → 迁移补丁 → up -d）。
#
# 说明：本作品用**同一个 seekdb 实例**承担 Dify 的三重职责：
#   ① Dify 部署主数据库（DB_TYPE=seekdb → 库 dify；plugin_daemon 用 MySQL 驱动 → 库 dify_plugin）
#   ② 知识库向量存储（VECTOR_STORE=seekdb → 库 dify_vector）
#   ③ 应用案卷库（书记员服务用 PyMySQL → 宿主机 2885 端口 → 库 absurd_court）
# 所有密码均为示例占位值，请按实际环境替换；不要提交真实凭据。
# ============================================================================

# ---- ① Dify 部署主数据库 = seekdb ------------------------------------------
DB_TYPE=seekdb
DB_HOST=seekdb
DB_PORT=2881
DB_USERNAME=root
DB_PASSWORD=<SEEKDB_PASSWORD>
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin
# plugin_daemon 是 Go 服务，只支持 postgresql|mysql 驱动；seekdb 兼容 MySQL 协议
PLUGIN_DAEMON_DB_TYPE=mysql

# ---- ② 知识库向量存储 = seekdb ----------------------------------------------
VECTOR_STORE=seekdb
OCEANBASE_VECTOR_HOST=seekdb
OCEANBASE_VECTOR_PORT=2881
OCEANBASE_VECTOR_USER=root
OCEANBASE_VECTOR_PASSWORD=<SEEKDB_PASSWORD>
OCEANBASE_VECTOR_DATABASE=dify_vector
# 可选：向量参数（默认值即可）
# OCEANBASE_VECTOR_METRIC_TYPE=cosine
# OCEANBASE_VECTOR_BATCH_SIZE=100

# ---- seekdb 容器 ------------------------------------------------------------
SEEKDB_MEMORY_LIMIT=2G
# 宿主机端口（容器内仍是 2881）；避免与本机其他 seekdb 容器（2881/2882）冲突
SEEKDB_HOST_PORT=2885

# ---- Web 入口端口 -----------------------------------------------------------
EXPOSE_NGINX_PORT=80

# ---- 可选：Dify Agent 本地沙箱（官方 compose 的 agent_backend 需要）----------
# DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=<RANDOM_TOKEN>
# DIFY_AGENT_SERVER_SECRET_KEY=<RANDOM_SECRET>

# ============================================================================
# 附：deployment/docker-compose.override.yaml（本作品实际使用）
# ----------------------------------------------------------------------------
# services:
#   seekdb:
#     ports: !override
#       - "${SEEKDB_HOST_PORT:-2885}:2881"
#   plugin_daemon:
#     environment:
#       DB_TYPE: ${PLUGIN_DAEMON_DB_TYPE:-mysql}
# ============================================================================