# ============================================================
# 环境变量样例（全部为占位值，请勿提交任何真实凭据）
# 复制为 minimax/.env 后按需填写；也可直接导出为进程环境变量。
# ============================================================

# ---- seekdb（MySQL 协议，默认远程端口 2881）----
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=speckit

# ---- MiniMax（OpenAI 兼容接口）----
MINIMAX_API_KEY=<your-key>
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# ---- PowerContext ----
# 状态文件目录；相对路径以 minimax/ 为基准
POWERCONTEXT_STATE_DIR=.powercontext
# 未填写（或未安装 powercontext 包）时自动降级为本地 JSON 状态
POWERCONTEXT_SERVER=