# Copy to .env and fill in real values. Never commit the real .env.
# MiniMax subscription key (M Plan / subscription key, starts with sk-cp-).
MINIMAX_API_KEY=sk-cp-REPLACE_WITH_YOUR_KEY
# OpenAI-compatible endpoint verified for the subscription key.
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3.1-Flash

# seekdb: embedded (starts a local instance, default, Linux only) or server
# (connect to an already running seekdb/OceanBase over MySQL).
SDD_SEEKDB_MODE=embedded
SDD_SEEKDB_HOST=127.0.0.1
SDD_SEEKDB_PORT=2881
SDD_SEEKDB_USER=root
SDD_SEEKDB_PASSWORD=
SDD_SEEKDB_DATABASE=sdd

# PowerContext storage backend for task state: seekdb (embedded) or sqlite.
POWERCONTEXT_BACKEND=seekdb

# Where seekdb/PowerContext keep their data. Defaults to minimax/runtime.
# NOTE: embedded seekdb needs a native Linux filesystem; when the repository is
# on a Windows drive (WSL /mnt/d), point this at a native path such as
# /var/tmp/minimax-runtime.
# SDD_DATA_DIR=/var/tmp/minimax-runtime