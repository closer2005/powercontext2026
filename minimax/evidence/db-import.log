{"at": "2026-10-28T08:48:38.208970+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["test:tests/test_pricing_regression.py:test_final_price_is_integer_cents", "test", "tests/test_pricing_regression.py", "tests/test_pricing_regression.py::test_final_price_is_integer_cents", "test_final_price_is_integer_cents", null, null, "active", "test_final_price_is_integer_cents", "def test_final_price_is_integer_cents():\n    \"\"\"最终价必须是 int（整数分），不是 float / Decimal。\"\"\"\n    customer = make_customer(tier=\"silver\", region=\"east\")\n    items = [make_item(unit_price_cents=1234, qty=1)]\n    total = final_price_cents(items, customer, make_coupon(amount_cents=99, min_spend_cents=0))\n    assert isinstance(total, int) and not isinstance(total, bool)", "test_final_price_is_integer_cents int float decimal def test_final_price_is_integer_cents int float decimal customer make_customer tier silver region east items make_item unit_price_cents 1234 qty 1 total final_price_cents items customer make_coupon amount_cents 99 min_spend_cents 0 assert isinstance total int and not isinstance total bool 最终 终价 价必 必须 须是 整数 数分 不是 最终 终价 价必 必须 须是 整数 数分 不是", "tests/test_pricing_regression.py", 113, 118, "10a9a68056207ef7", "2026-10-28T08:48:37.949364+00:00"], "rows": 1, "duration_ms": 12, "note": "upsert test:tests/test_pricing_regression.py:test_final_price_is_integer_cents"}
{"at": "2026-10-28T08:48:38.216755+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["test:tests/test_pricing_regression.py:test_coupon_never_increases_total", "test", "tests/test_pricing_regression.py", "tests/test_pricing_regression.py::test_coupon_never_increases_total", "test_coupon_never_increases_total", null, null, "active", "test_coupon_never_increases_total", "def test_coupon_never_increases_total():\n    \"\"\"同一订单加上一张达标券后，总价不会变高。\"\"\"\n    customer = make_customer(tier=\"basic\", region=\"east\")\n    items = [make_item(unit_price_cents=10000, qty=1)]\n    coupon = make_coupon(amount_cents=1500, min_spend_cents=5000)\n    assert final_price_cents(items, customer, coupon) < final_price_cents(items, customer)", "test_coupon_never_increases_total def test_coupon_never_increases_total customer make_customer tier basic region east items make_item unit_price_cents 10000 qty 1 coupon make_coupon amount_cents 1500 min_spend_cents 5000 assert final_price_cents items customer coupon final_price_cents items customer 同一 一订 订单 单加 加上 上一 一张 张达 达标 标券 券后 总价 价不 不会 会变 变高 同一 一订 订单 单加 加上 上一 一张 张达 达标 标券 券后 总价 价不 不会 会变 变高", "tests/test_pricing_regression.py", 121, 126, "9aeebb41fe40d779", "2026-10-28T08:48:37.949364+00:00"], "rows": 1, "duration_ms": 7, "note": "upsert test:tests/test_pricing_regression.py:test_coupon_never_increases_total"}
{"at": "2026-10-28T08:48:38.223268+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["test:tests/test_pricing_regression.py:test_final_price_does_not_mutate_inputs", "test", "tests/test_pricing_regression.py", "tests/test_pricing_regression.py::test_final_price_does_not_mutate_inputs", "test_final_price_does_not_mutate_inputs", null, null, "active", "test_final_price_does_not_mutate_inputs", "def test_final_price_does_not_mutate_inputs():\n    \"\"\"计价是纯函数，不修改入参。\"\"\"\n    items = [make_item(unit_price_cents=800, qty=2)]\n    customer = Customer(customer_id=\"C-9\", tier=\"gold\", region=\"west\")\n    final_price_cents(items, customer, make_coupon(50, 0))\n    assert items == [Item(name=\"widget\", unit_price_cents=800, qty=2)]\n    assert customer == Customer(customer_id=\"C-9\", tier=\"gold\", region=\"west\")", "test_final_price_does_not_mutate_inputs def test_final_price_does_not_mutate_inputs items make_item unit_price_cents 800 qty 2 customer customer customer_id c 9 tier gold region west final_price_cents items customer make_coupon 50 0 assert items item name widget unit_price_cents 800 qty 2 assert customer customer customer_id c 9 tier gold region west 计价 价是 是纯 纯函 函数 不修 修改 改入 入参 计价 价是 是纯 纯函 函数 不修 修改 改入 入参", "tests/test_pricing_regression.py", 129, 135, "dbed1e313059c09d", "2026-10-28T08:48:37.949364+00:00"], "rows": 1, "duration_ms": 6, "note": "upsert test:tests/test_pricing_regression.py:test_final_price_does_not_mutate_inputs"}
