{"at": "2026-10-28T08:48:38.103993+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["test:tests/test_pricing_regression.py:test_member_discount_floors_to_whole_cents", "test", "tests/test_pricing_regression.py", "tests/test_pricing_regression.py::test_member_discount_floors_to_whole_cents", "test_member_discount_floors_to_whole_cents", null, null, "active", "test_member_discount_floors_to_whole_cents", "def test_member_discount_floors_to_whole_cents():\n    \"\"\"折扣向下取整，且结果始终是 int（不引入浮点分）。\"\"\"\n    silver = member_discount_cents(999, \"silver\")  # 29.97 -> 29\n    gold = member_discount_cents(999, \"gold\")  # 49.95 -> 49\n    assert silver == 29\n    assert gold == 49\n    assert isinstance(silver, int) and not isinstance(silver, bool)\n    assert isinstance(gold, int) and not isinstance(gold, bool)", "test_member_discount_floors_to_whole_cents int def test_member_discount_floors_to_whole_cents int silver member_discount_cents 999 silver 29 97 29 gold member_discount_cents 999 gold 49 95 49 assert silver 29 assert gold 49 assert isinstance silver int and not isinstance silver bool assert isinstance gold int and not isinstance gold bool 折扣 扣向 向下 下取 取整 且结 结果 果始 始终 终是 不引 引入 入浮 浮点 点分 折扣 扣向 向下 下取 取整 且结 结果 果始 始终 终是 不引 引入 入浮 浮点 点分", "tests/test_pricing_regression.py", 64, 71, "2c2c3cd6f885a2e5", "2026-10-28T08:48:37.949364+00:00"], "rows": 1, "duration_ms": 9, "note": "upsert test:tests/test_pricing_regression.py:test_member_discount_floors_to_whole_cents"}
