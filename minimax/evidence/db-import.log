{"at": "2026-10-28T08:48:37.903961+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["code:src/ordercore/pricing.py:shipping_fee_cents", "code", "src/ordercore/pricing.py", "src/ordercore/pricing.py::shipping_fee_cents", "shipping_fee_cents", null, null, "active", "shipping_fee_cents", "def shipping_fee_cents(amount_cents: int, region: str, item_count: int = 0) -> int:\n    \"\"\"运费（分）：满 5 件免运费，未满 5 件按区域收费。\n\n    east 收 800 分，west 收 1200 分；空订单不收运费。\n    \"\"\"\n    if item_count == 0 or item_count >= 5:\n        return 0\n    if region == \"east\":\n        return 800\n    if region == \"west\":\n        return 1200\n    return 0", "ordercore pricing shipping_fee_cents 5 5 east 800 west 1200 def shipping_fee_cents amount_cents int region str item_count int 0 int 5 5 east 800 west 1200 if item_count 0 or item_count 5 return 0 if region east return 800 if region west return 1200 return 0 运费 分 满 件免 免运 运费 未满 件按 按区 区域 域收 收费 收 分 收 分 空订 订单 单不 不收 收运 运费 运费 分 满 件免 免运 运费 未满 件按 按区 区域 域收 收费 收 分 收 分 空订 订单 单不 不收 收运 运费", "ordercore.pricing", 93, 104, "3806cfc6d166277a", "2026-10-28T08:48:37.646893+00:00"], "rows": 1, "duration_ms": 27, "note": "upsert code:src/ordercore/pricing.py:shipping_fee_cents"}
{"at": "2026-10-28T08:48:37.949241+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["code:src/ordercore/pricing.py:final_price_cents", "code", "src/ordercore/pricing.py", "src/ordercore/pricing.py::final_price_cents", "final_price_cents", null, null, "active", "final_price_cents", "def final_price_cents(items: Iterable[Item], customer: Customer, coupon: Optional[Coupon] = None) -> int:\n    \"\"\"订单最终应付金额（分）。\n\n    按 SPEC-ORD-001 revision 2 顺序计价：\n    ``小计 → 减会员折扣 → 减优惠券 → 减 gold 奖励 → 加运费 → 下限 0``。\n\n    优惠券门槛按会员折扣后的当前应付金额判定。\n    \"\"\"\n    lines = _item_lines(items)\n    item_count = _item_count(lines)\n\n    amount = subtotal_cents(lines)\n    amount -= member_discount_cents(amount, customer.tier)\n    amount -= coupon_discount_cents(amount, coupon)\n    amount -= loyalty_bonus_cents(customer, item_count)\n    amount += shipping_fee_cents(amount, customer.region, item_count)\n    return max(0, amount)", "ordercore pricing final_price_cents spec ord 001 revision 2 gold 0 def final_price_cents items iterable item customer customer coupon optional coupon none int spec ord 001 revision 2 gold 0 lines _item_lines items item_count _item_count lines amount subtotal_cents lines amount member_discount_cents amount customer tier amount coupon_discount_cents amount coupon amount loyalty_bonus_cents customer item_count amount shipping_fee_cents amount customer region item_count return max 0 amount 订单 单最 最终 终应 应付 付金 金额 分 按 顺序 序计 计价 小计 减会 会员 员折 折扣 减优 优惠 惠券 减 奖励 加运 运费 下限 优惠 惠券 券门 门槛 槛按 按会 会员 员折 折扣 扣后 后的 的当 当前 前应 应付 付金 金额 额判 判定 订单 单最 最终 终应 应付 付金 金额 分 按 顺序 序计 计价 小计 减会 会员 员折 折扣 减优 优惠 惠券 减 奖励 加运 运费 下限 优惠 惠券 券门 门槛 槛按 按会 会员 员折 折扣 扣后 后的 的当 当前 前应 应付 付金 金额 额判 判定", "ordercore.pricing", 107, 123, "53a7aed5f818ff4c", "2026-10-28T08:48:37.646893+00:00"], "rows": 1, "duration_ms": 45, "note": "upsert code:src/ordercore/pricing.py:final_price_cents"}
{"at": "2026-10-28T08:48:37.973085+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["test:tests/test_pricing_regression.py:test_subtotal_sums_line_totals", "test", "tests/test_pricing_regression.py", "tests/test_pricing_regression.py::test_subtotal_sums_line_totals", "test_subtotal_sums_line_totals", null, null, "active", "test_subtotal_sums_line_totals", "def test_subtotal_sums_line_totals():\n    \"\"\"小计 = 各行 单价 × 数量 之和。\"\"\"\n    items = [\n        make_item(unit_price_cents=1999, qty=2),\n        make_item(unit_price_cents=500, qty=5),\n    ]\n    assert subtotal_cents(items) == 1999 * 2 + 500 * 5 == 6498", "test_subtotal_sums_line_totals def test_subtotal_sums_line_totals items make_item unit_price_cents 1999 qty 2 make_item unit_price_cents 500 qty 5 assert subtotal_cents items 1999 2 500 5 6498 小计 各行 单价 数量 之和 小计 各行 单价 数量 之和", "tests/test_pricing_regression.py", 29, 35, "3835120fa9b74758", "2026-10-28T08:48:37.949364+00:00"], "rows": 1, "duration_ms": 23, "note": "upsert test:tests/test_pricing_regression.py:test_subtotal_sums_line_totals"}
