{"at": "2026-10-28T08:48:37.830852+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["code:src/ordercore/pricing.py:subtotal_cents", "code", "src/ordercore/pricing.py", "src/ordercore/pricing.py::subtotal_cents", "subtotal_cents", null, null, "active", "subtotal_cents", "def subtotal_cents(items: Iterable[Item]) -> int:\n    \"\"\"订单小计（分）：各行 ``unit_price_cents * qty`` 之和。空明细返回 0。\"\"\"\n    return sum(item.unit_price_cents * item.qty for item in items)", "ordercore pricing subtotal_cents unit_price_cents qty 0 def subtotal_cents items iterable item int unit_price_cents qty 0 return sum item unit_price_cents item qty for item in items 订单 单小 小计 分 各行 之和 空明 明细 细返 返回 订单 单小 小计 分 各行 之和 空明 明细 细返 返回", "ordercore.pricing", 56, 58, "efd9a5d4bc600fd8", "2026-10-28T08:48:37.646893+00:00"], "rows": 1, "duration_ms": 16, "note": "upsert code:src/ordercore/pricing.py:subtotal_cents"}
{"at": "2026-10-28T08:48:37.844734+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["code:src/ordercore/pricing.py:member_discount_cents", "code", "src/ordercore/pricing.py", "src/ordercore/pricing.py::member_discount_cents", "member_discount_cents", null, null, "active", "member_discount_cents", "def member_discount_cents(amount_cents: int, tier: str) -> int:\n    \"\"\"会员折扣（分）：silver 3%、gold 5%、basic 0%，向下取整。\"\"\"\n    if tier not in _MEMBER_DISCOUNT_PERCENT:\n        raise ValueError(f\"未知会员等级: {tier!r}\")\n    return _percent_floor(amount_cents, _MEMBER_DISCOUNT_PERCENT[tier])", "ordercore pricing member_discount_cents silver 3 gold 5 basic 0 def member_discount_cents amount_cents int tier str int silver 3 gold 5 basic 0 if tier not in _member_discount_percent raise valueerror f tier r return _percent_floor amount_cents _member_discount_percent tier 会员 员折 折扣 分 向下 下取 取整 会员 员折 折扣 分 向下 下取 取整 未知 知会 会员 员等 等级", "ordercore.pricing", 61, 65, "4422d75921d191dc", "2026-10-28T08:48:37.646893+00:00"], "rows": 1, "duration_ms": 13, "note": "upsert code:src/ordercore/pricing.py:member_discount_cents"}
{"at": "2026-10-28T08:48:37.856929+00:00", "sql": "INSERT INTO sdd_materials (mat_id,kind,path,anchor,symbol,spec_id,revision,status,title,content,tokenized,tags,line_start,line_end,digest,updated_at) VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE kind=VALUES(kind),path=VALUES(path),anchor=VALUES(anchor),symbol=VALUES(symbol),spec_id=VALUES(spec_id),revision=VALUES(revision),status=VALUES(status),title=VALUES(title),content=VALUES(content),tokenized=VALUES(tokenized),tags=VALUES(tags),line_start=VALUES(line_start),line_end=VALUES(line_end),digest=VALUES(digest),updated_at=VALUES(updated_at)", "params": ["code:src/ordercore/pricing.py:coupon_discount_cents", "code", "src/ordercore/pricing.py", "src/ordercore/pricing.py::coupon_discount_cents", "coupon_discount_cents", null, null, "active", "coupon_discount_cents", "def coupon_discount_cents(amount_cents: int, coupon: Optional[Coupon]) -> int:\n    \"\"\"优惠券折扣（分）。\n\n    未达 ``coupon.min_spend_cents`` 返回 0；否则取 ``min(coupon.amount_cents, amount_cents)``，\n    保证券不会把金额扣成负数。\n    \"\"\"\n    if coupon is None:\n        return 0\n    if amount_cents < coupon.min_spend_cents:\n        return 0\n    return min(coupon.amount_cents, amount_cents)", "ordercore pricing coupon_discount_cents coupon min_spend_cents 0 min coupon amount_cents amount_cents def coupon_discount_cents amount_cents int coupon optional coupon int coupon min_spend_cents 0 min coupon amount_cents amount_cents if coupon is none return 0 if amount_cents coupon min_spend_cents return 0 return min coupon amount_cents amount_cents 优惠 惠券 券折 折扣 分 未达 返回 否则 则取 保证 证券 券不 不会 会把 把金 金额 额扣 扣成 成负 负数 优惠 惠券 券折 折扣 分 未达 返回 否则 则取 保证 证券 券不 不会 会把 把金 金额 额扣 扣成 成负 负数", "ordercore.pricing", 68, 78, "7421ec3abf5821b3", "2026-10-28T08:48:37.646893+00:00"], "rows": 1, "duration_ms": 12, "note": "upsert code:src/ordercore/pricing.py:coupon_discount_cents"}
