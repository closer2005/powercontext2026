{"at": "2026-10-28T08:48:43.697944+00:00", "sql": "CREATE TABLE IF NOT EXISTS sdd_materials ( mat_id VARCHAR(191) NOT NULL, kind VARCHAR(16) NOT NULL, path VARCHAR(255) NOT NULL, anchor VARCHAR(255) NOT NULL, symbol VARCHAR(191) NULL, spec_id VARCHAR(64) NULL, revision INT NULL, status VARCHAR(16) NOT NULL, title VARCHAR(255) NOT NULL, content MEDIUMTEXT NOT NULL, tokenized MEDIUMTEXT NOT NULL, tags VARCHAR(512) NULL, line_start INT NULL, line_end INT NULL, digest VARCHAR(64) NOT NULL, updated_at VARCHAR(32) NOT NULL, PRIMARY KEY (mat_id), KEY idx_kind_status (kind, status), KEY idx_spec (spec_id, revision) ) DEFAULT CHARSET = utf8mb4", "params": null, "rows": 0, "duration_ms": 52, "note": ""}
